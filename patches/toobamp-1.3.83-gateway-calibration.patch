+bool toob::SetRealtimeWorkerAffinity(int workerIndex)
+{
+    unsigned int cpuCount = std::thread::hardware_concurrency();
+    if (cpuCount < 4)
+    {
+        return false;
+    }
+
+    unsigned int workerCpuCount = cpuCount - 2;
+    unsigned int cpu = 2 + (unsigned int)workerIndex % workerCpuCount;
+    cpu_set_t cpuSet;
+    CPU_ZERO(&cpuSet);
+    CPU_SET(cpu, &cpuSet);
+    return pthread_setaffinity_np(pthread_self(), sizeof(cpuSet), &cpuSet) == 0;
+}
